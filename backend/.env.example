# Copy this file to .env and fill in your real values
# .env is gitignored and will NOT be pushed to GitHub

# Server port
PORT=5000

# MongoDB connection string — replace <user>, <password>, and <cluster> with your own
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# JWT secret — use a long random string in production
JWT_SECRET=your-secret-key-here

# Default seed user passwords — these set the initial login passwords on first run
# After seeding, change passwords through the app or database
SEED_INSTITUTION_PASSWORD=changeme
SEED_BMEU_PASSWORD=changeme
SEED_RDHS_PASSWORD=changeme

# Frontend URL for CORS — replace with your deployed frontend URL in production
CLIENT_URL=http://localhost:5173
